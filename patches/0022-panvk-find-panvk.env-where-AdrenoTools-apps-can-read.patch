From e88e5257790f4c19bd796f9f97f5ca554451884b Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Sun, 1 Nov 2026 02:01:25 +0300
Subject: [PATCH] panvk: find panvk.env where AdrenoTools apps can read it

AdrenoTools loaders run a patched copy of the driver from a temp/
directory, so the file next to the loaded library was never the one users
place, and ARMSX2's loader redirects fopen(). Read the first panvk.env
found in the driver's directory, its parent, /sdcard/Android/data/<pkg>/
files or /sdcard/Download, with open()/read().

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/vulkan/panvk_instance.c | 84 +++++++++++++++++++++-------
 1 file changed, 64 insertions(+), 20 deletions(-)

diff --git a/src/panfrost/vulkan/panvk_instance.c b/src/panfrost/vulkan/panvk_instance.c
index 46cfe47..98aead1 100644
--- a/src/panfrost/vulkan/panvk_instance.c
+++ b/src/panfrost/vulkan/panvk_instance.c
@@ -11,7 +11,9 @@
  */
 
 #include <dlfcn.h>
+#include <fcntl.h>
 #include <libgen.h>
+#include <unistd.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
@@ -70,26 +72,25 @@ uint64_t panvk_debug;
  * loaders in Winlator, ARMSX2, Eden) give no way to set environment variables.
  * Read KEY=VALUE lines from panvk.env next to the driver instead; variables
  * already in the environment win. */
-static void
-panvk_load_env_file(void)
+static bool
+panvk_read_env_file(const char *file)
 {
-   Dl_info info;
-   if (!dladdr((void *)panvk_load_env_file, &info) || !info.dli_fname)
-      return;
-
-   char path[4096];
-   snprintf(path, sizeof(path), "%s", info.dli_fname);
-   char *dir = dirname(path);
-   char file[4096];
-   snprintf(file, sizeof(file), "%s/panvk.env", dir);
-
-   FILE *f = fopen(file, "r");
-   if (!f)
-      return;
-
-   char line[1024];
-   while (fgets(line, sizeof(line), f)) {
-      line[strcspn(line, "\r\n")] = 0;
+   /* open()/read(), not fopen(): ARMSX2's driver loader redirects fopen(). */
+   int fd = open(file, O_RDONLY | O_CLOEXEC);
+   if (fd < 0)
+      return false;
+   char buf[8192];
+   ssize_t n = read(fd, buf, sizeof(buf) - 1);
+   close(fd);
+   if (n <= 0)
+      return false;
+   buf[n] = 0;
+
+   for (char *line = buf, *next; line && *line; line = next) {
+      next = strchr(line, '\n');
+      if (next)
+         *next++ = 0;
+      line[strcspn(line, "\r")] = 0;
       if (line[0] == '#' || !line[0])
          continue;
       char *eq = strchr(line, '=');
@@ -99,7 +100,50 @@ panvk_load_env_file(void)
       setenv(line, eq + 1, 0);
       mesa_logi("panvk: %s=%s (from %s)", line, getenv(line), file);
    }
-   fclose(f);
+   return true;
+}
+
+/*
+ * panvk.env: KEY=VALUE lines that set environment variables (not overriding ones already set),
+ * for apps that give no way to set them. The first file found is read, from: the driver's
+ * directory; its parent (AdrenoTools loaders run a patched copy from a temp/ subdirectory);
+ * /sdcard/Android/data/<package>/files (readable by Eden, ARMSX2 and Winlator);
+ * /sdcard/Download.
+ */
+static void
+panvk_load_env_file(void)
+{
+   char dirs[4][4096];
+   unsigned n = 0;
+
+   Dl_info info;
+   if (dladdr((void *)panvk_load_env_file, &info) && info.dli_fname) {
+      char path[4096];
+      snprintf(path, sizeof(path), "%s", info.dli_fname);
+      snprintf(dirs[n++], sizeof(dirs[0]), "%s", dirname(path));
+      snprintf(path, sizeof(path), "%s", dirs[0]);
+      snprintf(dirs[n++], sizeof(dirs[0]), "%s", dirname(path));
+   }
+
+   char pkg[256] = "";
+   int fd = open("/proc/self/cmdline", O_RDONLY | O_CLOEXEC);
+   if (fd >= 0) {
+      ssize_t r = read(fd, pkg, sizeof(pkg) - 1);
+      close(fd);
+      pkg[r > 0 ? r : 0] = 0;
+      /* "com.app:process" -> "com.app" */
+      pkg[strcspn(pkg, ":")] = 0;
+   }
+   if (pkg[0] && !strchr(pkg, '/'))
+      snprintf(dirs[n++], sizeof(dirs[0]), "/sdcard/Android/data/%s/files", pkg);
+   snprintf(dirs[n++], sizeof(dirs[0]), "/sdcard/Download");
+
+   for (unsigned i = 0; i < n; i++) {
+      char file[4200];
+      snprintf(file, sizeof(file), "%s/panvk.env", dirs[i]);
+      if (panvk_read_env_file(file))
+         return;
+   }
 }
 
 static void
-- 
2.43.0

