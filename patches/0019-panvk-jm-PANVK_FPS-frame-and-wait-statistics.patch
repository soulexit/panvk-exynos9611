From 1af574ebf8ece6ca2f5bc2afcafb330b35e5a2b1 Mon Sep 17 00:00:00 2001
From: soulexit <metehan.tanriverdi01@gmail.com>
Date: Sun, 1 Nov 2026 00:53:12 +0300
Subject: [PATCH] panvk/jm: PANVK_FPS frame and wait statistics

PANVK_FPS=1 logs, every 5 s: frames/s (render passes writing an imported
buffer -- the AHardwareBuffers Winlator's wrapper and Android's WSI
present), submits/s, and the CPU time blocked in submit-time waits and in
sync-object waits. Measures FPS in apps where the driver never sees a
present (Winlator's wrapper has its own X11 WSI).

Assisted-by: LLM
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/panfrost/lib/kmod/kbase_kmod.c          | 15 +++++
 src/panfrost/lib/kmod/kbase_kmod.h          |  2 +
 src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c | 63 +++++++++++++++++++++
 3 files changed, 80 insertions(+)

diff --git a/src/panfrost/lib/kmod/kbase_kmod.c b/src/panfrost/lib/kmod/kbase_kmod.c
index cd63aaf..1839602 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.c
+++ b/src/panfrost/lib/kmod/kbase_kmod.c
@@ -1622,13 +1622,28 @@ ks_wait_locked(uint32_t *handles, unsigned n, int64_t timeout_nsec, unsigned fla
    }
 }
 
+/* PANVK_FPS: CPU time spent blocked in sync-object waits (vkWaitForFences, semaphore waits). */
+static uint64_t ks_wait_ns, ks_wait_count;
+
+void
+kbase_kmod_wait_stats(uint64_t *ns, uint64_t *count)
+{
+   *ns = p_atomic_xchg(&ks_wait_ns, 0);
+   *count = p_atomic_xchg(&ks_wait_count, 0);
+}
+
 static int
 ks_wait(struct util_sync_provider *p, uint32_t *handles, unsigned n, int64_t timeout_nsec,
         unsigned flags, uint32_t *first_signaled)
 {
+   const uint64_t t0 = ks_now();
    pthread_mutex_lock(&ks_lock);
    const int ret = ks_wait_locked(handles, n, timeout_nsec, flags, first_signaled);
    pthread_mutex_unlock(&ks_lock);
+   if (timeout_nsec) {
+      p_atomic_add(&ks_wait_ns, ks_now() - t0);
+      p_atomic_inc(&ks_wait_count);
+   }
    return ks_ret(ret);
 }
 
diff --git a/src/panfrost/lib/kmod/kbase_kmod.h b/src/panfrost/lib/kmod/kbase_kmod.h
index 97390e9..2c6e6b0 100644
--- a/src/panfrost/lib/kmod/kbase_kmod.h
+++ b/src/panfrost/lib/kmod/kbase_kmod.h
@@ -177,6 +177,8 @@ bool pan_kmod_kbase_csf_group_faulted(const struct pan_kmod_kbase_csf_group *gro
 void kbase_kmod_dump_recent_frees(uint64_t lo, uint64_t hi);
 void kbase_kmod_dump_maps_once(void);
 int kbase_kmod_va_check(uint64_t va, uint64_t size);
+/* PANVK_FPS: CPU time blocked in sync-object waits since the last call, and their number. */
+void kbase_kmod_wait_stats(uint64_t *ns, uint64_t *count);
 void kbase_kmod_shader_register(uint64_t va, const void *bin, size_t size);
 const void *kbase_kmod_shader_lookup(uint64_t va, size_t *size);
 
diff --git a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
index dc5bdf2..e5abc31 100644
--- a/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
+++ b/src/panfrost/vulkan/jm/panvk_vX_gpu_queue.c
@@ -33,7 +33,10 @@
 #include <stdio.h>
 #include <unistd.h>
 
+#include "kmod/kbase_kmod.h"
 #include "kmod/pan_kmod.h"
+#include "util/os_time.h"
+#include "util/u_debug.h"
 
 #include "drm-uapi/panfrost_drm.h"
 
@@ -939,9 +942,67 @@ panvk_signal_event_syncobjs(struct panvk_gpu_queue *queue,
    }
 }
 
+/*
+ * PANVK_FPS=1: every 5 s, log frames/s (render passes writing an imported buffer -- the
+ * AHardwareBuffers Winlator's wrapper and Android's WSI present), submits/s, the CPU time spent
+ * blocked in submit-time waits and in sync-object waits (summed over threads).
+ */
+static struct {
+   int enabled;
+   uint64_t t0, frames, submits, submit_wait_ns;
+} fps_stats = {.enabled = -1};
+
+static void
+fps_stats_tick(void)
+{
+   const uint64_t now = os_time_get_nano();
+   if (!fps_stats.t0) {
+      fps_stats.t0 = now;
+      return;
+   }
+   const uint64_t dt = now - fps_stats.t0;
+   if (dt < 5000000000ull)
+      return;
+
+   uint64_t wait_ns = 0, waits = 0;
+   kbase_kmod_wait_stats(&wait_ns, &waits);
+   const double s = dt / 1e9;
+   mesa_logi("panvk fps: %.1f frames/s, %.1f submits/s, submit-wait %.1f ms/s, "
+             "sync-wait %.1f ms/s (%.0f waits/s)",
+             fps_stats.frames / s, fps_stats.submits / s, fps_stats.submit_wait_ns / 1e6 / s,
+             wait_ns / 1e6 / s, waits / s);
+   fps_stats.t0 = now;
+   fps_stats.frames = fps_stats.submits = fps_stats.submit_wait_ns = 0;
+}
+
+static void
+fps_stats_submit(struct vk_queue_submit *submit, uint64_t wait_ns)
+{
+   fps_stats.submits++;
+   fps_stats.submit_wait_ns += wait_ns;
+   for (uint32_t j = 0; j < submit->command_buffer_count; ++j) {
+      struct panvk_cmd_buffer *cmdbuf =
+         container_of(submit->command_buffers[j], struct panvk_cmd_buffer, vk);
+      list_for_each_entry(struct panvk_batch, batch, &cmdbuf->batches, node) {
+         if (!batch->frag_jc.first_job)
+            continue;
+         for (unsigned i = 0; i < batch->fb.bo_count; i++) {
+            if (batch->fb.bos[i]->flags & PAN_KMOD_BO_FLAG_IMPORTED) {
+               fps_stats.frames++;
+               break;
+            }
+         }
+      }
+   }
+   fps_stats_tick();
+}
+
 VkResult
 panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_submit *submit)
 {
+   if (unlikely(fps_stats.enabled < 0))
+      fps_stats.enabled = debug_get_bool_option("PANVK_FPS", false);
+   const uint64_t submit_t0 = fps_stats.enabled ? os_time_get_nano() : 0;
    struct panvk_gpu_queue *queue = container_of(vk_queue, struct panvk_gpu_queue, vk);
    struct panvk_device *dev = to_panvk_device(queue->vk.base.device);
 
@@ -965,6 +1026,8 @@ panvk_per_arch(gpu_queue_submit)(struct vk_queue *vk_queue, struct vk_queue_subm
                          DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL |
                             DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE,
                          NULL);
+   if (fps_stats.enabled)
+      fps_stats_submit(submit, os_time_get_nano() - submit_t0);
 
    if (pan_kmod_dev_is_kbase(dev->kmod.dev) && !PANVK_DEBUG(TRACE) && !PANVK_DEBUG(DUMP) &&
        !getenv("PANVK_GS_DUMP")) {
